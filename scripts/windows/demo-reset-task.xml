<?xml version="1.0" encoding="UTF-16"?>
<!--
Import Task Scheduler:
schtasks /Create /XML "scripts\windows\demo-reset-task.xml" /TN "\InfraFlow\DemoReset"
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>InfraFlow Demo - Reset date tranzactionale zilnic la 03:00</Description>
    <URI>\InfraFlow\DemoReset</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T03:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions>
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NonInteractive -ExecutionPolicy Bypass -File "E:\CODEX 1\InfraFlow-workspace-2.10.5-clean\scripts\windows\reset-demo.ps1"</Arguments>
      <WorkingDirectory>E:\CODEX 1\InfraFlow-workspace-2.10.5-clean</WorkingDirectory>
    </Exec>
  </Actions>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
</Task>
