# Copiază acest fișier în /etc/infraflow/infraflow.env, setează proprietarul
# root:infraflow și permisiunile 0640. Nu păstra parole reale în directorul app.
NODE_ENV=production
PORT=4180
INFRAFLOW_HOST=127.0.0.1
INFRAFLOW_DB_PROVIDER=mssql
DB_SERVER=127.0.0.1,1433
DB_DATABASE=INFRAFLOW
DB_USER=infraflow
DB_PASSWORD=SCHIMBA_CU_O_PAROLA_LUNGA_UNICA
DB_ENCRYPT=false
APP_KEY=GENEREAZA_O_CHEIE_ALEATOARE_LUNGA
INFRAFLOW_SCHEDULER_DISABLED=0
