# ═══════════════════════════════════════════════════════════════
# InfraFlow ERP — Configurare server
# Copiază acest fișier ca .env și completează valorile.
# ═══════════════════════════════════════════════════════════════

PORT=4180
INFRAFLOW_PORT=4180
NODE_ENV=production

# ─────────────────────────────────────────────────────────────
# Mod bază de date:
#   json  → development/standalone (fișier data/app-db.json)
#   mssql → producție (SQL Server)
# ─────────────────────────────────────────────────────────────
DB_MODE=json

# ─────────────────────────────────────────────────────────────
# SQL Server — completează dacă DB_MODE=mssql
#
# Pentru SERVER\CIEL cu autentificare Windows (recomandat):
# INFRAFLOW_DB_CONNECTION=Server=SERVER\CIEL;Database=InfraFlow;Trusted_Connection=yes;TrustServerCertificate=yes
#
# Pentru autentificare SQL (user + parolă):
# INFRAFLOW_DB_CONNECTION=Server=SERVER\CIEL;Database=InfraFlow;User Id=infraflow_user;Password=parola_sigura;TrustServerCertificate=yes
#
# Pentru SQL Server Express local:
# INFRAFLOW_DB_CONNECTION=Server=.\SQLEXPRESS;Database=InfraFlow;Trusted_Connection=yes;TrustServerCertificate=yes
# ─────────────────────────────────────────────────────────────
INFRAFLOW_DB_CONNECTION=

# Provider DB (lasă mssql dacă folosești SQL Server)
INFRAFLOW_DB_PROVIDER=mssql

# ─────────────────────────────────────────────────────────────
# Cheie criptare setări sensibile (min 32 caractere, obligatoriu în producție)
# Generează cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
APP_KEY=schimba-aceasta-cheie-cu-una-secreta-de-cel-putin-32-caractere

# ─────────────────────────────────────────────────────────────
# Email SMTP (opțional — pentru notificări și resetare parole)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=infraflow@firma.ro

# ─────────────────────────────────────────────────────────────
# AI Assistant (opțional — Anthropic API)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# GPS / Autominder (opțional — integrare vehicule)
# ─────────────────────────────────────────────────────────────
GPS_PROVIDER=urmariregps.ro
GPS_API_URL=
GPS_API_KEY=
