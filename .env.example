# ═══════════════════════════════════════════════════════════════
# InfraFlow ERP — Configurare server
# Copiază acest fișier ca .env și completează valorile.
# ═══════════════════════════════════════════════════════════════

PORT=4180
INFRAFLOW_PORT=4180
NODE_ENV=production

# ─────────────────────────────────────────────────────────────
# Mod bază de date:
#   mssql → producție (SQL Server Express implicit)
#   json  → doar development explicit (fișier data/app-db.json)
# ─────────────────────────────────────────────────────────────
DB_MODE=mssql
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=INFRAFLOW
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=false
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
MSSQL_RELATIONAL=0

# ─────────────────────────────────────────────────────────────
# SQL Server — completează dacă DB_MODE=mssql
#
# Pentru SERVER\CIEL cu autentificare Windows (recomandat):
# INFRAFLOW_DB_CONNECTION=Server=SERVER\CIEL;Database=INFRAFLOW;User Id=infraflow;Password=parola;TrustServerCertificate=yes
#
# Pentru autentificare SQL (user + parolă):
# Credentialele de producție se salvează în runtime/mssql.env prin configure-mssql-login.ps1.
#
# Pentru SQL Server Express local:
# INFRAFLOW_DB_CONNECTION=Server=.\SQLEXPRESS;Database=INFRAFLOW;User Id=infraflow;Password=parola;TrustServerCertificate=yes
# ─────────────────────────────────────────────────────────────
INFRAFLOW_DB_CONNECTION=

# Provider DB (lasă mssql dacă folosești SQL Server)
INFRAFLOW_DB_PROVIDER=mssql

# ─────────────────────────────────────────────────────────────
# Cheie criptare setări sensibile (min 32 caractere, obligatoriu în producție)
# Generează cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
APP_KEY=schimba-aceasta-cheie-cu-una-secreta-de-cel-putin-32-caractere

# ─────────────────────────────────────────────────────────────
# Email SMTP (opțional — pentru notificări și resetare parole)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=infraflow@firma.ro

# ─────────────────────────────────────────────────────────────
# AI Assistant (opțional — Anthropic API)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# GPS / Autominder (opțional — integrare vehicule)
# ─────────────────────────────────────────────────────────────
GPS_PROVIDER=urmariregps.ro
GPS_API_URL=
GPS_API_KEY=
